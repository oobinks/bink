// Cloudflare settings for the app. You shouldn't need to edit this.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctrinn-hq",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The database and backup storage are created automatically on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "ctrinn-hq" }],
  "kv_namespaces": [{ "binding": "BACKUPS" }],
  // Nightly jobs at 02:00 UTC (2am in winter, 3am in summer, UK time).
  "triggers": { "crons": ["0 2 * * *"] },
  // Keep the variables you set in the Cloudflare dashboard (ACCESS_TEAM_DOMAIN, OWNER_EMAILS).
  "keep_vars": true,
  "observability": { "enabled": true }
}
